# ============================================================================
# E-COMMERCE AI EMPIRE - exemplo de configuração
# Copie para .env e preencha somente o que você tiver.
# O arquivo .env NUNCA deve ser commitado (.gitignore já cuida disso).
# ============================================================================

# ------------------------------------------------------------------- básico --
APP_NAME="E-COMMERCE AI EMPIRE"
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_CURRENCY=BRL
APP_LOCALE=pt-BR
# Exigir login no painel (crie o usuário em Configurações > Segurança antes)
APP_REQUIRE_LOGIN=false

# -------------------------------------------------------------------- banco --
# sqlite = padrão, gratuito, zero configuração, arquivo local em data/empire.db
# supabase = persistência em nuvem (aplique database/schema.sql no seu projeto)
DATABASE_BACKEND=sqlite
SQLITE_PATH=data/empire.db
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SCHEMA=public

# ----------------------------------------------------------------------- IA --
# Ordem de preferência. "offline" sempre existe e não custa nada.
AI_PROVIDERS=gemini,openai_compatible,offline
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=2048
AI_MAX_CALLS_PER_TASK=4
AI_TEMPERATURE=0.4
# 0 = sem bloqueio por orçamento (use a camada gratuita). Ajuste se quiser teto.
AI_MONTHLY_BUDGET_USD=0

# Google Gemini (camada gratuita disponível em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Qualquer endpoint compatível com OpenAI: Ollama, llama.cpp, LM Studio, Groq...
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# ------------------------------------------------------------- execução ------
TASK_TIMEOUT_SECONDS=300
TASK_MAX_ATTEMPTS=3
TASK_DEDUPE_WINDOW_MINUTES=30
REQUIRE_APPROVAL=true
ENABLED_CHANNELS=shopee,mercadolivre,tiktok_shop,instagram,woocommerce
POSTS_PER_DAY=3
MIN_HOURS_BETWEEN_POSTS=4

# ------------------------------------------------------------------ Shopee --
# https://open.shopee.com  (partner_id, partner_key e shop_id da loja)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# ------------------------------------------------------------ Mercado Livre --
# https://developers.mercadolivre.com.br  (fluxo OAuth 2.0)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# ---------------------------------------------------------------- TikTok Shop --
# https://partner.tiktokshop.com
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=

# ------------------------------------------------------------------ Instagram --
# Meta Graph API: conta profissional + app com permissões de leitura/publicação
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# --------------------------------------------------------------- WooCommerce --
# Loja própria / WordPress: WooCommerce > Configurações > Avançado > REST API
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
