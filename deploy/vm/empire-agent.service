[Unit]
Description=E-COMMERCE AI EMPIRE - super agente (bot + autonomia)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ecommerce-ai-empire
EnvironmentFile=/home/ubuntu/ecommerce-ai-empire/.env
ExecStart=/home/ubuntu/ecommerce-ai-empire/.venv/bin/python -m scripts.run_agent
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
